# Load all packages needed for this analysis
library(tidyverse)        # data wrangling: dplyr, tidyr, ggplot2
library(readxl)           # reading .xlsx files
library(languageEntropy)  # computing language entropy
# Set the path to your BLP Excel file.
# If the file is in the same folder as this .Rmd, just use the filename.
blp_file <- "BLP data - PROJECT Heritage phonology and syntax.xlsx"
# Read the Responses sheet
blp_raw <- read_excel(blp_file, sheet = "Responses")
# Quick check: how many participants (rows) and items (columns)?
cat("Rows (participants):", nrow(blp_raw), "
")
cat("Columns (items):", ncol(blp_raw), "
")
# Preview the first few rows and first 8 columns
blp_raw[1:5, 1:8]
# Trim any leading/trailing whitespace from column names
colnames(blp_raw) <- trimws(colnames(blp_raw))
# Create a numeric participant ID (row number) and select the 9 usage columns
blp_use <- blp_raw %>%
mutate(id = row_number()) %>%
select(
id,
friends_english    = contains("ENGLISH with friends"),
friends_spanish    = contains("SPANISH with friends"),
friends_other      = contains("OTHER LANGUAGES with friends"),
family_english     = contains("ENGLISH with family"),
family_spanish     = contains("SPANISH with family"),
family_other       = contains("OTHER LANGUAGES with family"),
schoolwork_english = contains("ENGLISH at school/work"),
schoolwork_spanish = contains("SPANISH at school/work"),
schoolwork_other   = contains("OTHER LANGUAGES at school/work")
)
head(blp_use)
# Compute row sums for each context
blp_use <- blp_use %>%
mutate(
sum_friends    = friends_english    + friends_spanish    + friends_other,
sum_family     = family_english     + family_spanish     + family_other,
sum_schoolwork = schoolwork_english + schoolwork_spanish + schoolwork_other
)
# Global chunk options
knitr::opts_chunk$set(echo = TRUE, message = TRUE, warning = TRUE)
# Load all packages needed for this analysis
library(tidyverse)        # data wrangling: dplyr, tidyr, ggplot2
library(readxl)           # reading .xlsx files
library(languageEntropy)  # computing language entropy
# Set the path to your BLP Excel file.
# If the file is in the same folder as this .Rmd, just use the filename.
blp_file <- "BLP data - PROJECT Heritage phonology and syntax.xlsx"
# Read the Responses sheet
blp_raw <- read_excel(blp_file, sheet = "Responses")
# Quick check: how many participants (rows) and items (columns)?
cat("Rows (participants):", nrow(blp_raw), "
")
cat("Columns (items):", ncol(blp_raw), "
")
# Preview the first few rows and first 8 columns
blp_raw[1:5, 1:8]
# Trim any leading/trailing whitespace from column names
colnames(blp_raw) <- trimws(colnames(blp_raw))
# Create a numeric participant ID (row number) and select the 9 usage columns
blp_use <- blp_raw %>%
mutate(id = row_number()) %>%
select(
id,
friends_english    = contains("ENGLISH with friends"),
friends_spanish    = contains("SPANISH with friends"),
friends_other      = contains("OTHER LANGUAGES with friends"),
family_english     = contains("ENGLISH with family"),
family_spanish     = contains("SPANISH with family"),
family_other       = contains("OTHER LANGUAGES with family"),
schoolwork_english = contains("ENGLISH at school/work"),
schoolwork_spanish = contains("SPANISH at school/work"),
schoolwork_other   = contains("OTHER LANGUAGES at school/work")
)%>%
# Extract the pure number, ignoring %, +, letters, etc.
mutate(across(-id, ~ parse_number(as.character(.))))
head(blp_use)
# Compute row sums for each context
blp_use <- blp_use %>%
mutate(
sum_friends    = friends_english    + friends_spanish    + friends_other,
sum_family     = family_english     + family_spanish     + family_other,
sum_schoolwork = schoolwork_english + schoolwork_spanish + schoolwork_other
)
# Flag any rows where a context sum falls outside 95-105
problem_rows <- blp_use %>%
filter(
!between(sum_friends,    95, 105) |
!between(sum_family,     95, 105) |
!between(sum_schoolwork, 95, 105)
)
if (nrow(problem_rows) == 0) {
cat("All context percentages sum to approximately 100. No issues found.
")
} else {
cat("WARNING: The following participants have context sums outside 95-105:
")
print(problem_rows %>% select(id, sum_friends, sum_family, sum_schoolwork))
}
# Drop the sum-check columns, then divide all usage columns by 100
blp_props <- blp_use %>%
select(-starts_with("sum_")) %>%
mutate(
across(
.cols = -id,
.fns  = ~ . / 100
)
)
head(blp_props)
# pivot_longer() stacks all usage columns into rows.
# Column names like "friends_english" are split into domain and lang.
blp_long <- blp_props %>%
pivot_longer(
cols      = -id,
names_to  = "name",
values_to = "prop"
) %>%
separate(
col  = name,
into = c("domain", "lang"),
sep  = "_"
) %>%
# Scrub any hidden number artifacts (like "other...2") from the language names
mutate(lang = str_remove(lang, "\\.\\.\\.[0-9]+")) %>%
filter(!is.na(prop)) %>%
# Guarantee absolute uniqueness per ID, Domain, and Language
group_by(id, domain, lang) %>%
slice(1) %>%
ungroup() %>%
# Convert to a base R data.frame to prevent tibble compatibility bugs
as.data.frame()
head(blp_long, 12)
cat("Domains:", unique(blp_long$domain), "\n")
cat("Languages:", unique(blp_long$lang), "\n")
# The languageEntropy package is incompatible with long-format data.
# We bypass it by calculating Shannon entropy directly: H = -sum(p * log2(p))
entropy_results <- blp_long %>%
# log(0) is undefined, so we only calculate entropy for languages actually used
filter(prop > 0) %>%
group_by(id, domain) %>%
summarize(
entropy = -sum(prop * log2(prop)),
.groups = "drop"
)
# Check what columns were returned
cat("Output column names:\n")
print(names(entropy_results))
head(entropy_results, 12)
# Summary statistics by domain
# NOTE: if the entropy column is named something other than 'entropy'
# (check names(entropy_results) above), replace 'entropy' below accordingly.
entropy_results %>%
group_by(domain) %>%
summarize(
n      = n(),
mean_H = mean(entropy, na.rm = TRUE),
sd_H   = sd(entropy, na.rm = TRUE),
min_H  = min(entropy, na.rm = TRUE),
max_H  = max(entropy, na.rm = TRUE),
.groups = "drop"
)
# Boxplot with individual participant points overlaid
ggplot(entropy_results, aes(x = domain, y = entropy, fill = domain)) +
geom_boxplot(alpha = 0.5, outlier.shape = NA) +
geom_jitter(width = 0.15, size = 2, alpha = 0.7) +
labs(
title = "Language Entropy by Context",
x     = "Context (domain)",
y     = "Entropy (H)"
) +
theme_minimal() +
theme(legend.position = "none")
# Average entropy across all three contexts per participant
global_entropy <- entropy_results %>%
group_by(id) %>%
summarize(
entropy_global = mean(entropy, na.rm = TRUE),
.groups = "drop"
)
head(global_entropy)
# Global chunk options
knitr::opts_chunk$set(echo = TRUE, message = TRUE, warning = TRUE)
